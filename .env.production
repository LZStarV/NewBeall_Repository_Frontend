# 生产环境配置
NODE_ENV=production

# API 基础地址 - 生产环境 (请根据实际情况修改)
VITE_API_BASE_URL=https://api.your-domain.com/api

# WebSocket 基础地址 (请根据实际情况修改)
WS_BASE_URL=wss://your-domain.com

# Img等静态资源等前置url
VITE_BASE_STATIC_URL=https://yx.newbeall.com/softLink/

# 超时设置
VITE_REQUEST_TIMEOUT=10000

# 生产环境特有配置
VITE_APP_ENV=production
VITE_DEBUG=false

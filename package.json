{
  "name": "newbeall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint --config .commitlintrc.cjs -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint"
    ],
    "*.{css,less,scss}": [
      "stylelint --config .stylelintrc.cjs --fix"
    ],
    "*.{ts,tsx,js,json,html,yml,css,less,scss,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "cz-customizable": {
      "config": ".cz-config.cjs"
    },
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "npm run install:proxy && concurrently \"vite\" \"npm run proxy\"",
    "proxy": "cd proxy-server && npm run dev",
    "install:proxy": "cd proxy-server && npm install",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "lint:strict": "eslint . --ext .js,.ts,.vue --max-warnings 0",
    "lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "dependencies": {
    "@layui/layui-vue": "^2.22.0",
    "@types/node": "^22.14.1",
    "axios": "^1.8.4",
    "chart.js": "^4.5.0",
    "commitizen": "^4.3.1",
    "commitlint-config-cz": "^0.13.3",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.4.0",
    "eslint-config-prettier": "^10.1.5",
    "js-cookie": "^3.0.5",
    "layui-vue": "^0.0.1",
    "newbeall": "file:",
    "pinia": "^3.0.2",
    "postcss-scss": "^4.0.9",
    "quill": "^2.0.3",
    "resize-observer-polyfill": "^1.5.1",
    "screenfull": "^6.0.2",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-prettier": "^5.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/css": "^0.7.0",
    "@eslint/js": "^9.26.0",
    "@eslint/json": "^0.12.0",
    "@popperjs/core": "^2.11.8",
    "@types/js-cookie": "^3.0.6",
    "@vitejs/plugin-vue": "^5.2.2",
    "@vue/tsconfig": "^0.7.0",
    "bootstrap": "^5.3.8",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "husky": "^8.0.0",
    "jquery": "^3.7.1",
    "lint-staged": "^15.5.2",
    "prettier": "3.5.3",
    "sass": "^1.87.0",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.32.1",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^6.3.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^3.2.2",
    "vue-tsc": "^2.2.8"
  }
}
